# Copy values to .env. Keep real credentials out of source control.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Stage D image generation (existing Seedream_api_key spelling is also accepted).
SEEDREAM_API_KEY=

# Optional HTTP proxy. Replace this example port with your proxy's port.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost

# Optional runtime data location (default: .local-data under this project).
# GEO_DATA_DIR=/absolute/path/to/local-data

# Optional Chinese TTF/TTC font. Windows/macOS use available system fonts.
# GEO_LABEL_FONT=/absolute/path/to/font.ttc
